//Basic definitions of characters

DIGIT =%x30-39
ALPHA = %x41-5A / %x61-7A
SP = %x20
CRLF = %x0D %x0A
VCHAR = %x21-7E

pin-format = 4*6DIGIT ; between 4 and 6 digits
card = 6*20(ALPHA/DIGIT) ; between 6 and 20 digits or letters
amount = 1*DIGIT ["." 2DIGIT] ; at least 1 Digit or 2 digits seperated by '.'
reason = 1*(VCHAR / SP)  
text = 1*(VCHAR / SP)  

//header
version ="Version:" SP 1*DIGIT
msg_id = "MsgId:" SP 1*(ALPHA /DIGIT) CRLF
correlation_id = "CorrelationId:" SP 1*(ALPHA /DIGIT) CRLF
msg_type = "Type:" SP ( hello / karte / pin / kontostand_r / abheben_r / bye /karte_ok / pin_ok  / abheben_ok / error )
timestamp = "Timestamp in Millis: " SP 1*DIGIT CRLF

header = version SP msg_id SP correlation_id SP  msg_type SP timestamp CRLF 

//ABNF-rules for different msgTypes

message = header CRLF CRLF body CRLF 
body = request / response CRLF

//request-messages
request = hello / karte / pin / kontostand_r / abheben_r / bye

hello ="HELLO" CRLF
karte = "KARTE" SP card CRLF
pin = "PIN" SP pin-format CRLF 
kontostand_req = "KONTOSTAND_REQ" SP card CRLF
abheben_req = "ABHEBEN_REQ" SP card SP amount CRLF
bye = "BYE" SP text CRLF

//response-messages

response = karte_ok / pin_ok  / kontostand / abheben_ok / error 

karte_ok = "KARTE_OK" CRLF
pin_ok ="PIN_OK" CRLF
kontostand ="KONTOSTAND" SP amount CRLF
abheben_ok = "ABHEBEN_OK" SP "DISPENSED" SP amount CRLF
error = "ERROR" SP reason CRLF




